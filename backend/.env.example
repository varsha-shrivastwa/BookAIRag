# Server
PORT=4000
NODE_ENV=production

# Database (use 'postgres' as host when running via Docker Compose)
DATABASE_URL=postgresql://raguser:ragpass@postgres:5432/book_rag_db

# External API Keys
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding & LLM Settings
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
LLM_MODEL=gemini-3.6-flash

# CORS (set to your frontend origin)
CORS_ORIGIN=http://localhost:3000
