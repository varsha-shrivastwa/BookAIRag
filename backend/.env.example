# Server
PORT=4000
NODE_ENV=production

# Database (use 'postgres' as host when running via Docker Compose)
DATABASE_URL=postgresql://raguser:ragpass@postgres:5432/book_rag_db

# External API Keys
GEMINI_API_KEY=your_gemini_api_key_here
CLAUDE_API_KEY=your_anthropic_api_key_here

# Embedding & LLM Settings
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
LLM_MODEL=gemini-3.6-flash

# Claude-specific (optional — used when AI_PROVIDER=claude)
CLAUDE_LLM_MODEL=claude-sonnet-4-6
CLAUDE_VISION_MODEL=claude-sonnet-4-6
# Claude has no embedding API; set a Gemini key here for document search
CLAUDE_EMBEDDING_API_KEY=your_gemini_api_key_here
CLAUDE_EMBEDDING_MODEL=gemini-embedding-001

# CORS (set to your frontend origin)
CORS_ORIGIN=http://localhost:3000
